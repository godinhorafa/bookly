{
    "openapi": "3.1.2",
    "info": {
        "title": "Bookly API",
        "version": "1.0.0",
        "description": "Space booking API. Errors use RFC 9457 problem details (docs/api/problems.md). Unsafe requests accept an Idempotency-Key header."
    },
    "servers": [
        {
            "url": "http://localhost:8000/api"
        }
    ],
    "security": [
        {
            "bearerAuth": []
        }
    ],
    "paths": {
        "/bookings": {
            "get": {
                "operationId": "booking.index",
                "summary": "List my bookings, latest first",
                "tags": [
                    "Booking"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {}
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            },
            "post": {
                "operationId": "booking.store",
                "description": "The slot is held as `pending` until it is paid. The response includes an\nitemised quote explaining the price.",
                "summary": "Book a space",
                "tags": [
                    "Booking"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateBookingRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {}
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/bookings/{booking}": {
            "get": {
                "operationId": "booking.show",
                "summary": "Show one of my bookings",
                "tags": [
                    "Booking"
                ],
                "parameters": [
                    {
                        "name": "booking",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {}
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/bookings/{booking}/payment": {
            "post": {
                "operationId": "booking.pay",
                "description": "A declined card is answered with `402` and the provider's reason; the\nbooking stays pending so the customer can try another card.",
                "summary": "Pay for a pending booking, which confirms it",
                "tags": [
                    "Booking"
                ],
                "parameters": [
                    {
                        "name": "booking",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PayBookingRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {}
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "402": {
                        "description": "",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "type": {
                                            "type": "string",
                                            "const": "https://github.com/godinhorafa/bookly/blob/main/docs/api/problems.md#payment-declined"
                                        },
                                        "title": {
                                            "type": "string",
                                            "const": "Payment declined"
                                        },
                                        "status": {
                                            "type": "integer",
                                            "const": 402
                                        },
                                        "detail": {
                                            "type": "string",
                                            "const": "The payment method was declined. Try another one."
                                        },
                                        "decline_reason": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "type",
                                        "title",
                                        "status",
                                        "detail",
                                        "decline_reason"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/bookings/{booking}/cancellation": {
            "post": {
                "operationId": "booking.cancel",
                "summary": "Cancel one of my bookings. The refund follows the space's cancellation policy",
                "tags": [
                    "Booking"
                ],
                "parameters": [
                    {
                        "name": "booking",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {}
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/spaces": {
            "get": {
                "operationId": "space.index",
                "summary": "List bookable spaces",
                "tags": [
                    "Space"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {}
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/spaces/{space}/availability": {
            "get": {
                "operationId": "space.availability",
                "summary": "Busy slots of a space between two instants (at most 62 days apart)",
                "tags": [
                    "Space"
                ],
                "parameters": [
                    {
                        "name": "space",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "from",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "date-time"
                        }
                    },
                    {
                        "name": "to",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "date-time"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "space_id": {
                                                    "type": "string"
                                                },
                                                "from": {
                                                    "type": "string"
                                                },
                                                "to": {
                                                    "type": "string"
                                                },
                                                "busy": {
                                                    "type": "array",
                                                    "items": {}
                                                }
                                            },
                                            "required": [
                                                "space_id",
                                                "from",
                                                "to",
                                                "busy"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/tokens": {
            "post": {
                "operationId": "token.store",
                "summary": "Exchange credentials for a bearer token",
                "tags": [
                    "Token"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/IssueTokenRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "token": {
                                            "type": "string"
                                        },
                                        "token_type": {
                                            "type": "string",
                                            "const": "Bearer"
                                        }
                                    },
                                    "required": [
                                        "token",
                                        "token_type"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "type": {
                                            "anyOf": [
                                                {
                                                    "type": "string",
                                                    "const": "https://github.com/godinhorafa/bookly/blob/main/docs/api/problems.md#unauthenticated"
                                                },
                                                {}
                                            ]
                                        },
                                        "title": {
                                            "anyOf": [
                                                {
                                                    "type": "string",
                                                    "const": "Invalid credentials"
                                                },
                                                {}
                                            ]
                                        },
                                        "status": {
                                            "anyOf": [
                                                {
                                                    "type": "integer",
                                                    "const": 401
                                                },
                                                {}
                                            ]
                                        },
                                        "detail": {
                                            "anyOf": [
                                                {
                                                    "type": "string",
                                                    "const": "The e-mail or password is incorrect."
                                                },
                                                {}
                                            ]
                                        }
                                    },
                                    "required": [
                                        "type",
                                        "title",
                                        "status",
                                        "detail"
                                    ],
                                    "additionalProperties": {}
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                },
                "security": []
            }
        },
        "/me": {
            "get": {
                "operationId": "token.me",
                "summary": "The authenticated customer",
                "tags": [
                    "Token"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "integer"
                                        },
                                        "name": {
                                            "type": "string"
                                        },
                                        "email": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "id",
                                        "name",
                                        "email"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "description": "Token from POST /api/tokens",
                "scheme": "bearer"
            }
        },
        "schemas": {
            "CreateBookingRequest": {
                "type": "object",
                "description": "Checks the *shape* of the request only. Business rules (notice, duration,\nopening hours...) belong to the domain and come back as 422 problems.",
                "properties": {
                    "space_id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "start": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "end": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "coupon": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 32
                    }
                },
                "required": [
                    "space_id",
                    "start",
                    "end"
                ],
                "title": "CreateBookingRequest"
            },
            "IssueTokenRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "password": {
                        "type": "string"
                    },
                    "device_name": {
                        "type": "string",
                        "maxLength": 100
                    }
                },
                "required": [
                    "email",
                    "password",
                    "device_name"
                ],
                "title": "IssueTokenRequest"
            },
            "PayBookingRequest": {
                "type": "object",
                "properties": {
                    "payment_method": {
                        "type": "string",
                        "description": "A payment method token from the provider, e.g. Stripe's \"pm_card_visa\" in test mode.",
                        "maxLength": 255
                    }
                },
                "required": [
                    "payment_method"
                ],
                "title": "PayBookingRequest"
            }
        },
        "responses": {
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            },
            "AuthenticationException": {
                "description": "Unauthenticated",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            }
        }
    }
}