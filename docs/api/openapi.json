{
    "openapi": "3.1.2",
    "info": {
        "title": "Bookly API",
        "version": "1.0.0",
        "description": "Space booking API. Errors use RFC 9457 problem details (docs/api/problems.md). Unsafe requests accept an Idempotency-Key header."
    },
    "servers": [
        {
            "url": "http://localhost:8000/api"
        }
    ],
    "security": [
        {
            "bearerAuth": []
        }
    ],
    "paths": {
        "/bookings": {
            "get": {
                "operationId": "booking.index",
                "summary": "List my bookings, latest first",
                "tags": [
                    "Booking"
                ],
                "responses": {
                    "200": {
                        "description": "Array of `BookingResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/BookingResource"
                                            }
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            },
            "post": {
                "operationId": "booking.store",
                "description": "The slot is held as `pending` until it is paid. The response includes an\nitemised quote explaining the price.",
                "summary": "Book a space",
                "tags": [
                    "Booking"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateBookingRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "`BookingResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/BookingResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/bookings/{booking}": {
            "get": {
                "operationId": "booking.show",
                "summary": "Show one of my bookings",
                "tags": [
                    "Booking"
                ],
                "parameters": [
                    {
                        "name": "booking",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "`BookingResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/BookingResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/bookings/{booking}/payment": {
            "post": {
                "operationId": "booking.pay",
                "description": "A declined card is answered with `402` and the provider's reason; the\nbooking stays pending so the customer can try another card.",
                "summary": "Pay for a pending booking, which confirms it",
                "tags": [
                    "Booking"
                ],
                "parameters": [
                    {
                        "name": "booking",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PayBookingRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`BookingResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/BookingResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "402": {
                        "description": "",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "type": {
                                            "type": "string",
                                            "const": "https://github.com/godinhorafa/bookly/blob/main/docs/api/problems.md#payment-declined"
                                        },
                                        "title": {
                                            "type": "string",
                                            "const": "Payment declined"
                                        },
                                        "status": {
                                            "type": "integer",
                                            "const": 402
                                        },
                                        "detail": {
                                            "type": "string",
                                            "const": "The payment method was declined. Try another one."
                                        },
                                        "decline_reason": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "type",
                                        "title",
                                        "status",
                                        "detail",
                                        "decline_reason"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/bookings/{booking}/cancellation": {
            "post": {
                "operationId": "booking.cancel",
                "summary": "Cancel one of my bookings. The refund follows the space's cancellation policy",
                "tags": [
                    "Booking"
                ],
                "parameters": [
                    {
                        "name": "booking",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "`BookingResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/BookingResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/spaces": {
            "get": {
                "operationId": "space.index",
                "summary": "List bookable spaces",
                "tags": [
                    "Space"
                ],
                "responses": {
                    "200": {
                        "description": "Array of `SpaceResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/SpaceResource"
                                            }
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/spaces/{space}/availability": {
            "get": {
                "operationId": "space.availability",
                "summary": "Busy slots of a space between two instants (at most 62 days apart)",
                "tags": [
                    "Space"
                ],
                "parameters": [
                    {
                        "name": "space",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "from",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "date-time"
                        }
                    },
                    {
                        "name": "to",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "date-time"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "`AvailabilityResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/AvailabilityResource"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/tokens": {
            "post": {
                "operationId": "token.store",
                "summary": "Exchange credentials for a bearer token",
                "tags": [
                    "Token"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/IssueTokenRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "token": {
                                            "type": "string"
                                        },
                                        "token_type": {
                                            "type": "string",
                                            "const": "Bearer"
                                        }
                                    },
                                    "required": [
                                        "token",
                                        "token_type"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "type": {
                                            "anyOf": [
                                                {
                                                    "type": "string",
                                                    "const": "https://github.com/godinhorafa/bookly/blob/main/docs/api/problems.md#unauthenticated"
                                                },
                                                {}
                                            ]
                                        },
                                        "title": {
                                            "anyOf": [
                                                {
                                                    "type": "string",
                                                    "const": "Invalid credentials"
                                                },
                                                {}
                                            ]
                                        },
                                        "status": {
                                            "anyOf": [
                                                {
                                                    "type": "integer",
                                                    "const": 401
                                                },
                                                {}
                                            ]
                                        },
                                        "detail": {
                                            "anyOf": [
                                                {
                                                    "type": "string",
                                                    "const": "The e-mail or password is incorrect."
                                                },
                                                {}
                                            ]
                                        }
                                    },
                                    "required": [
                                        "type",
                                        "title",
                                        "status",
                                        "detail"
                                    ],
                                    "additionalProperties": {}
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                },
                "security": []
            }
        },
        "/me": {
            "get": {
                "operationId": "token.me",
                "summary": "The authenticated customer",
                "tags": [
                    "Token"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "integer"
                                        },
                                        "name": {
                                            "type": "string"
                                        },
                                        "email": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "id",
                                        "name",
                                        "email"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "description": "Token from POST /api/tokens",
                "scheme": "bearer"
            }
        },
        "schemas": {
            "AdjustmentKind": {
                "type": "string",
                "enum": [
                    "surcharge",
                    "discount"
                ],
                "title": "AdjustmentKind"
            },
            "AdjustmentResource": {
                "type": "object",
                "properties": {
                    "rule": {
                        "type": "string",
                        "description": "Machine-readable rule id, e.g. `peak_hours`, `long_booking`, `coupon`."
                    },
                    "description": {
                        "type": "string"
                    },
                    "kind": {
                        "$ref": "#/components/schemas/AdjustmentKind"
                    },
                    "amount": {
                        "$ref": "#/components/schemas/MoneyResource"
                    }
                },
                "required": [
                    "rule",
                    "description",
                    "kind",
                    "amount"
                ],
                "title": "AdjustmentResource"
            },
            "AvailabilityResource": {
                "type": "object",
                "properties": {
                    "space_id": {
                        "type": "string"
                    },
                    "from": {
                        "type": "string"
                    },
                    "to": {
                        "type": "string"
                    },
                    "busy": {
                        "type": "array",
                        "description": "Slots held by active bookings, in order. Who booked them is not disclosed.",
                        "items": {
                            "$ref": "#/components/schemas/SlotResource"
                        }
                    }
                },
                "required": [
                    "space_id",
                    "from",
                    "to",
                    "busy"
                ],
                "title": "AvailabilityResource"
            },
            "BookingResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "status": {
                        "$ref": "#/components/schemas/BookingStatus"
                    },
                    "space_id": {
                        "type": "string"
                    },
                    "start": {
                        "type": "string",
                        "description": "ISO 8601, UTC."
                    },
                    "end": {
                        "type": "string",
                        "description": "ISO 8601, UTC; the slot is half-open: [start, end)."
                    },
                    "price": {
                        "$ref": "#/components/schemas/MoneyResource"
                    },
                    "hold_until": {
                        "type": "string",
                        "description": "Pending bookings only: pay before this instant (ISO 8601, UTC) or the booking expires and frees its slot."
                    },
                    "quote": {
                        "anyOf": [
                            {
                                "description": "Only in the response that created the booking.",
                                "$ref": "#/components/schemas/QuoteResource"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "cancellation": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/CancellationResource"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    }
                },
                "required": [
                    "id",
                    "status",
                    "space_id",
                    "start",
                    "end",
                    "price"
                ],
                "title": "BookingResource"
            },
            "BookingStatus": {
                "type": "string",
                "description": "Lifecycle: Pending -> Confirmed (after payment) -> Cancelled. A pending booking can also be cancelled, or expire when it is not paid in time.\n",
                "enum": [
                    "pending",
                    "confirmed",
                    "cancelled",
                    "expired"
                ],
                "title": "BookingStatus"
            },
            "CancellationPolicyType": {
                "type": "string",
                "description": "The policies a space owner can choose from. Each one maps to a concrete strategy.\n| |\n|---|\n| `flexible` <br/> 100% up to 24h before, 50% after that. |\n| `moderate` <br/> 100% up to 48h before, 50% up to 24h before, nothing after. |\n| `strict` <br/> 50% up to 7 days before, nothing after. |\n| `non_refundable` <br/>  |",
                "enum": [
                    "flexible",
                    "moderate",
                    "strict",
                    "non_refundable"
                ],
                "title": "CancellationPolicyType"
            },
            "CancellationResource": {
                "type": "object",
                "properties": {
                    "cancelled_at": {
                        "type": "string"
                    },
                    "refund": {
                        "$ref": "#/components/schemas/MoneyResource"
                    }
                },
                "required": [
                    "cancelled_at",
                    "refund"
                ],
                "title": "CancellationResource"
            },
            "CreateBookingRequest": {
                "type": "object",
                "description": "Checks the *shape* of the request only. Business rules (notice, duration,\nopening hours...) belong to the domain and come back as 422 problems.",
                "properties": {
                    "space_id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "start": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "end": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "coupon": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 32
                    }
                },
                "required": [
                    "space_id",
                    "start",
                    "end"
                ],
                "title": "CreateBookingRequest"
            },
            "IssueTokenRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "password": {
                        "type": "string"
                    },
                    "device_name": {
                        "type": "string",
                        "maxLength": 100
                    }
                },
                "required": [
                    "email",
                    "password",
                    "device_name"
                ],
                "title": "IssueTokenRequest"
            },
            "MoneyResource": {
                "type": "object",
                "properties": {
                    "amount": {
                        "type": "integer",
                        "description": "In minor units, e.g. 12050 for BRL 120.50."
                    },
                    "currency": {
                        "type": "string"
                    }
                },
                "required": [
                    "amount",
                    "currency"
                ],
                "title": "MoneyResource"
            },
            "PayBookingRequest": {
                "type": "object",
                "properties": {
                    "payment_method": {
                        "type": "string",
                        "description": "A payment method token from the provider, e.g. Stripe's \"pm_card_visa\" in test mode.",
                        "maxLength": 255
                    }
                },
                "required": [
                    "payment_method"
                ],
                "title": "PayBookingRequest"
            },
            "QuoteResource": {
                "type": "object",
                "properties": {
                    "base": {
                        "$ref": "#/components/schemas/MoneyResource"
                    },
                    "adjustments": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/AdjustmentResource"
                        }
                    },
                    "total": {
                        "$ref": "#/components/schemas/MoneyResource"
                    }
                },
                "required": [
                    "base",
                    "adjustments",
                    "total"
                ],
                "title": "QuoteResource"
            },
            "SlotResource": {
                "type": "object",
                "properties": {
                    "start": {
                        "type": "string"
                    },
                    "end": {
                        "type": "string"
                    }
                },
                "required": [
                    "start",
                    "end"
                ],
                "title": "SlotResource"
            },
            "SpaceResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "timezone": {
                        "type": "string",
                        "description": "IANA time zone; opening and peak hours are in this zone."
                    },
                    "capacity": {
                        "type": "integer"
                    },
                    "hourly_rate": {
                        "$ref": "#/components/schemas/MoneyResource"
                    },
                    "cancellation_policy": {
                        "$ref": "#/components/schemas/CancellationPolicyType"
                    },
                    "opening_hours": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/WeeklyWindowResource"
                        }
                    }
                },
                "required": [
                    "id",
                    "name",
                    "timezone",
                    "capacity",
                    "hourly_rate",
                    "cancellation_policy",
                    "opening_hours"
                ],
                "title": "SpaceResource"
            },
            "WeeklyWindowResource": {
                "type": "object",
                "properties": {
                    "weekdays": {
                        "type": "array",
                        "description": "ISO weekdays, 1 = Monday ... 7 = Sunday.",
                        "items": {
                            "type": "integer"
                        }
                    },
                    "start": {
                        "type": "string",
                        "description": "Local time, HH:MM."
                    },
                    "end": {
                        "type": "string",
                        "description": "Local time, HH:MM; may be 24:00."
                    }
                },
                "required": [
                    "weekdays",
                    "start",
                    "end"
                ],
                "title": "WeeklyWindowResource"
            }
        },
        "responses": {
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            },
            "AuthenticationException": {
                "description": "Unauthenticated",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            }
        }
    }
}